{
  "info": {
    "name": "Knowledge Risk Analyzer Postman Collection",
    "description": "Continuous engineering knowledge risk intelligence. Analyzes code \nownership, bus factor, orphaned modules, and onboarding paths to \nidentify where critical knowledge is dangerously concentrated. \nAnswers the questions every CTO fears: \"What happens if this \nengineer leaves?\" and \"Who would fix this at 3 AM?\" Prevents \nsilent organizational fragility from becoming catastrophic outages.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://knowledgerisk.forgesphere.lightning.com/v1",
      "type": "string",
      "description": "Override with the base URL of the deployed Kong gateway."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "repoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "modulePath",
      "value": "",
      "type": "string",
      "description": "Optional sub-path. If omitted, analyzes entire repo."
    },
    {
      "key": "windowDays",
      "value": "",
      "type": "string",
      "description": "How far back to analyze (days)."
    },
    {
      "key": "minContributionWeight",
      "value": "",
      "type": "string"
    },
    {
      "key": "minFileAgeDays",
      "value": "",
      "type": "string",
      "description": "Only include files unchanged for this many days."
    },
    {
      "key": "minFileSizeLines",
      "value": "",
      "type": "string",
      "description": "Ignore trivially small files."
    },
    {
      "key": "ownerStatus",
      "value": "",
      "type": "string",
      "description": "Filter by ownership situation."
    },
    {
      "key": "sort",
